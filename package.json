{
  "name": "@netsepio/erebrus-mcp",
  "version": "0.2.0",
  "description": "MCP server for Erebrus gateway — agent self-auth, orgs, API keys, nodes, VPN, Drop (stdio)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "erebrus-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NetSepio/erebrus-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/NetSepio/erebrus-mcp/issues"
  },
  "homepage": "https://github.com/NetSepio/erebrus-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "erebrus",
    "mcp",
    "netsepio",
    "vpn",
    "depin",
    "stdio"
  ]
}
