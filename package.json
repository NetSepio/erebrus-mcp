{
  "name": "@netsepio/erebrus-mcp",
  "version": "0.1.0",
  "description": "MCP server for Erebrus gateway — agent onboarding (orgs, API keys, node tokens, VPN/Drop later)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "erebrus-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
