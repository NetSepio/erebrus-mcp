    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NetSepio/erebrus-mcp.git"
  },
  "keywords": [
    "erebrus",
    "mcp",
    "netsepio",
    "vpn",
    "depin"
