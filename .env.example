# Gateway base URL (no trailing slash)
EREBRUS_GATEWAY_URL=https://gateway.erebrus.io

# Optional: pre-seeded user PASETO (CI/operators). Agents should use auth_* tools instead.
EREBRUS_BEARER_TOKEN=

# Org API key (X-Api-Key) — today only /api/v2/org/* (VPN clients + usage)
EREBRUS_API_KEY=

# Optional default org id when tools omit org_id
EREBRUS_DEFAULT_ORG_ID=

# Transport: stdio (default) or http for a local MCP listener
# MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=3100
# Optional lock on local HTTP /mcp only (not Erebrus login)
# MCP_AUTH_TOKEN=
