# Gateway base URL (no trailing slash)
EREBRUS_GATEWAY_URL=https://gateway.erebrus.io

# User PASETO from wallet/social login (Authorization: Bearer …)
# Required for: orgs, API keys, node registration tokens, org nodes, profile.
EREBRUS_BEARER_TOKEN=

# Org API key (X-Api-Key: erebrus_sk_…)
# Today only scopes to /api/v2/org/* (VPN clients + usage). Optional for Phase 1.
EREBRUS_API_KEY=

# Optional default org id when tools omit org_id
EREBRUS_DEFAULT_ORG_ID=
